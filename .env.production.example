# ============================================================================
#  قالب متغيّرات البيئة للإنتاج — Render + Neon + Supabase Storage
#  انسخ هذه المفاتيح إلى Render → Environment. لا ترفع القيم السرّية إلى Git.
# ============================================================================

APP_NAME=CulturalSystem
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # ولّده محلياً: php artisan key:generate --show
APP_URL=https://your-service.onrender.com
LOG_CHANNEL=stderr

# ---------- Neon (PostgreSQL) — استخدم رابط الـ Pooler ----------
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.<region>.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

# ---------- الحالة على قاعدة البيانات (قرص Render مؤقّت يُمحى كل نشر) ----------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- Supabase Storage (متوافق S3) ----------
FILESYSTEM_DISK=public
PUBLIC_DISK_DRIVER=s3           # قرص "public" (الأغلفة) → Supabase
BOOKS_DISK_DRIVER=s3            # قرص "books_private" (PDF) → Supabase (خاص، روابط موقّتة)
AWS_ACCESS_KEY_ID=your_supabase_s3_key
AWS_SECRET_ACCESS_KEY=your_supabase_s3_secret
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_PUBLIC_BUCKET=cultural-public       # bucket عام (الأغلفة/الصور)
AWS_PRIVATE_BUCKET=cultural-private      # bucket خاص (ملفات PDF) — أنشئه في Supabase
PUBLIC_DISK_URL=https://<ref>.supabase.co/storage/v1/object/public/cultural-public
