# ============================================================================
#  قالب متغيّرات البيئة للإنتاج — Render + Neon + Cloudflare R2
#  انسخ هذه المفاتيح إلى Render → Environment. لا ترفع القيم الحقيقية إلى Git.
# ============================================================================

APP_NAME=Cultural-Project
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # ولّده محلياً: php artisan key:generate --show
APP_URL=https://your-service.onrender.com
LOG_CHANNEL=stderr

# ---------- قاعدة البيانات: Neon (PostgreSQL) — استخدم رابط الـ Pooler ----------
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

# ---------- الحالة على قاعدة البيانات (قرص Render مؤقّت يُمحى عند كل نشر) ----------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------- التخزين: Cloudflare R2 (متوافق S3) ----------
FILESYSTEM_DISK=public
PUBLIC_DISK_DRIVER=s3           # يجعل قرص "public" يخزّن الأغلفة على R2
BOOKS_DISK_DRIVER=s3            # يجعل قرص "books_private" يخزّن الـ PDF على R2 (خاص)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_PUBLIC_BUCKET=cultural-public       # bucket عام (الأغلفة/الصور)
R2_PRIVATE_BUCKET=cultural-private     # bucket خاص (ملفات PDF)
PUBLIC_DISK_URL=https://pub-xxxxxxxx.r2.dev   # رابط R2 العام للـ bucket العام
